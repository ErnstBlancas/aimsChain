#!/bin/bash
# ============================================================================
# SLURM template for one FHI-AIMS single-point run on a chain node.
#
# run_chain.py (engine=aims) copies this file into each chain-node directory
# and substitutes three tokens before submission:
#     OUTPUT  ->  <node-dir>.out   (FHI-AIMS stdout; parsed for E / F / stress)
#     LABEL   ->  job label
#     ANCHOR  ->  <node-dir>/aims  (kept for compatibility with the original
#                tools/runchain.py substitution; unused in this template)
#
# Adjust AIMS_BINARY and the SLURM directives for your cluster.
# ============================================================================
#SBATCH -J title
#SBATCH -o aims.out
#SBATCH -e aims.out
#SBATCH -N 1
#SBATCH --ntasks=16
#SBATCH --time=24:00:00
#SBATCH --partition=YOUR_PARTITION   # <-- adjust
#SBATCH --account=YOUR_ACCOUNT       # <-- adjust, or delete this line

# Work inside the node directory regardless of the job start directory.
cd "$(dirname "$(readlink -f "$0")")"

AIMS_BINARY=/path/to/aims.x          # <-- adjust

mpiexec -n $SLURM_NTASKS "$AIMS_BINARY" > aims.out
